.data
newLine: .asciz "\n"
str_de_paridade:   .string "bit-paridade: " 
str_saida:      .string "saida: "
str_erro:       .string "entrada incorreta\n" 

.text
.globl main

main:
	li a7, 5
	ecall
	mv t0, a0
	
	li t2, 128
	bge t0, t2, handle_error
	
	li t3, 0    # contador = 0
	mv t4, t0
	
		
	loop:
		beqz t0, exit
		
		andi t1, t0, 1   # pega o valor do bit menos significativo
		add t3, t3, t1   # Adicona 1 ao contador se for 1 o bit da iteração
		
		srli t0, t0, 1   #shift pra direita e para pegar o proximo bit
		j loop
		
		exit:
			
			andi t1, t3, 1
			
			li t5, 128
			mul t5, t1, t5
			add t5, t4, t5
			
			la a0, str_de_paridade
			li a7, 4
			ecall
			
			mv a0, t1
			li a7, 1
			ecall
			
			la a0, newLine
			li a7, 4
			ecall
			
			la a0, str_saida
			li a7, 4
			ecall
			
			mv a0, t5
			li a7, 1
			ecall
			
			la a0, newLine
			li a7, 4
			ecall
			
			li a7, 10
			ecall
handle_error:
	la a0, str_erro
	li a7, 4
	ecall
	
	li a7, 10
	ecall
		