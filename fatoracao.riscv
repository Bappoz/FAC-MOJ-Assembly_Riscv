.data
msg_invalid: .string "Entrada invalida.\n"   # texto para entrada fora do intervalo

.text
.globl main

main:
    li a7, 5          # lê inteiro
    ecall
    mv t0, a0         # guarda N em t0

    li t1, 1          # testa limite inferior
    ble t0, t1, invalid
    li t1, 32768      # testa limite superior
    bge t0, t1, invalid

    li t1, 2          # divisor inicial

factor_loop:
    bgt t1, t0, end   # acabou se divisor > N

try_divide:
    rem t2, t0, t1    # verifica se divisor divide N
    bnez t2, next_div # se resto != 0, tenta outro divisor

    mv a0, t1         # imprime o fator
    jal ra, print_int

    div t0, t0, t1    # reduz N
    j try_divide      # tenta dividir novamente pelo mesmo divisor

next_div:
    addi t1, t1, 1    # próximo divisor
    j factor_loop

end:
    li a7, 10         # encerra
    ecall

print_int:
    li a7, 1          # syscall: print int
    ecall
    li a0, 10         # '\n'
    li a7, 11         # print char
    ecall
    ret

invalid:
    la a0, msg_invalid  # imprime erro
    li a7, 4
    ecall
    li a7, 10           # encerra
    ecall
