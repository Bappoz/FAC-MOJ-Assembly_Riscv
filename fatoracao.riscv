.data
handle_error: .asciz "Entrada Invalida."
newLine: .asciz "\n"
.text
.globl main

main:
	li a7, 5
	ecall
	mv t0, a0
	
	la a0, newLine
	li a7, 4
	ecall
	
	li t1, 2
	blt t0, t1, input_error
	li t1, 32768
	bge t0, t1, input_error
	
	mv t2, t0
	loop1:
	     	li t3, 2
	     	
		rem t4, t2, t3
		bnez t4, loop1_out
		
		
		mv a0, t3
		li a7, 1
		ecall
		
		la a0, newLine
		li a7, 4
		ecall
		
		srli t2, t2, 1
		
		j loop1
		
	loop1_out:
		
		li t1, 3
		loop2:
			mul t3, t1, t1
			bgt t3, t2, loop2_out
			
			while:
				rem t4, t2, t3
			    	bnez t4, ext_while
			    	
			    	mv a0, t1
			    	li a7, 1
			    	ecall
			    	
			    	la a0, newLine
			    	li a7, 4
			    	ecall
			    	
			    	div t2, t2, t1
			    	
			 	j while
			 	
			ext_while:
				addi t1, t1, 2
				j loop2
				
				
				
		loop2_out:
			li t3, 1
			ble t2, t3, end
			
			mv a0, t2
			li a7, 1
			ecall
			
			la a0, newLine
			li a7, 4
			ecall
			
		end:
			li a7, 10
			ecall
			
	input_error:
	la a0, handle_error
	li a7, 4
	ecall
	
	li a7, 10
	ecall