.data                   # Início da seção de dados: onde ficam variáveis e strings

mensagem:               # Rótulo (nome da variável que guarda a string)
    .asciz "Ola Mundo\n"    # Define uma string terminada em zero 
                            

.text                   # Inícia a seção de código 
.globl main             # Torna a label 'main' visível ao sistema, é o ponto de entrada

main:                   # Ponto inicial do programa
    la a0, mensagem      # Carrega o endereço da string "mensagem" no registrador a0
    li a7, 4             # Carrega o número da syscall 4 em a7 (significa imprimir string
    ecall                # Executa o syscall

    li a7, 10            # Carrega o número da syscall 10 em a7 (significa encerrar programa)
   ecall                # Executa a syscall de término
