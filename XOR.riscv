.data
handle_error: .asciz "Numero invalido!"
newLine: .asciz "\n"
res: .asciz "XOR: "
.text
.globl main

main:
   
li a7, 5
ecall
mv t0, a0

li t2, 51
beq t0, t2, error

li t1, 0
while:
  bge t1, t0, end_loop
  
  li a7, 5
  ecall

  mv a1, a0

  li a7, 5
  ecall

  mv a2, a0
  addi t1, t1, 1

  # ---- XOR ----   
  # (A OR B) AND NOT (A AND B)

  or t2, a1, a2
  
  and t3, a1, a2
  xori t3, t3, -1
  
  and t4, t3, t2
  
  li t5, 1
  beq t4, t0, retorno_one
  
  
  la a0, res
  li a7, 4
  ecall
  
  li a0, 1
  li a7, 1
  ecall
  
  la a0, newLine
  li a7, 4
  ecall
  
  j while


retorno_one:

  la a0, res
  li a7, 4
  ecall
  
  li, a0, 2
  li a7, 1
  ecall
  
  j while
  
end_loop:
  li a7, 10
  ecall



error:
la a0, handle_error
li a7, 4
ecall  
